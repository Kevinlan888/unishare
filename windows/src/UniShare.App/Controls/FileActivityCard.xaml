<UserControl x:Class="UniShare.App.Controls.FileActivityCard" Width="320"  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border x:Name="Card" CornerRadius="14" Padding="10" BorderThickness="1" BorderBrush="{ThemeResource DividerBrush}" Background="{ThemeResource IncomingBackground}"><VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="Incoming"><VisualState.Setters><Setter Target="Card.Background" Value="{ThemeResource IncomingBackground}"/></VisualState.Setters></VisualState><VisualState x:Name="Outgoing"><VisualState.Setters><Setter Target="Card.Background" Value="{ThemeResource OutgoingBackground}"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><StackPanel Spacing="4"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8A5;" FontSize="30" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Size}" Style="{StaticResource SecondaryText}"/></StackPanel></Grid><StackPanel x:Name="ProgressPanel" Spacing="4"><ProgressBar x:Uid="TransferProgress" Value="{Binding Progress}" Maximum="100" MinWidth="200"/><TextBlock x:Uid="DemoProgress" Style="{StaticResource SecondaryText}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"><TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding Time}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/><Button x:Name="CancelButton" x:Uid="CancelButton" MinHeight="24" Height="24" FontSize="12" Padding="8,2" Click="CancelClick"/></StackPanel><StackPanel x:Name="DecisionPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button x:Name="AcceptButton" x:Uid="AcceptButton" Click="AcceptClick" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="RejectButton" x:Uid="RejectButton" Click="RejectClick"/><Button x:Name="RetryButton" x:Uid="RetryButton" Click="RetryClick"/></StackPanel></StackPanel></Border></UserControl>
