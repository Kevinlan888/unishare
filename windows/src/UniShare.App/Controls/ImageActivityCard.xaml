<UserControl
  x:Class="UniShare.App.Controls.ImageActivityCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border
    x:Name="Card"
    DoubleTapped="OpenDoubleTapped"
    PointerEntered="RefreshFileAvailability"
    CornerRadius="14"
    Padding="8"
    BorderThickness="1"
    BorderBrush="{ThemeResource DividerBrush}"
    Background="{ThemeResource IncomingBackground}">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState
          x:Name="Incoming">
          <VisualState.Setters>
            <Setter
              Target="Card.Background"
              Value="{ThemeResource IncomingBackground}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState
          x:Name="Outgoing">
          <VisualState.Setters>
            <Setter
              Target="Card.Background"
              Value="{ThemeResource OutgoingBackground}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <StackPanel
      Spacing="8">
      <Button
        x:Name="PreviewButton"
        Click="PreviewClick"
        Padding="0"
        CornerRadius="10"
        Visibility="Collapsed">
        <Image
          x:Name="Thumbnail"
          Width="368"
          Height="174"
          Stretch="Uniform" />
      </Button>
      <TextBlock
        Text="{Binding Name}"
        FontWeight="SemiBold" />
      <TextBlock
        Text="{Binding Size}"
        Style="{StaticResource SecondaryText}" />
      <StackPanel
        x:Name="ProgressPanel"
        Spacing="4">
        <ProgressBar
          x:Uid="TransferProgress"
          Value="{Binding Progress}"
          Maximum="100"
          MinWidth="200" />
        <TextBlock
          Text="{Binding ProgressText}"
          Style="{StaticResource SecondaryText}" />
        <StackPanel
          x:Name="MetricsPanel"
          Orientation="Horizontal"
          Spacing="6">
          <TextBlock
            Text="{Binding SpeedText}"
            Style="{StaticResource SecondaryText}" />
          <TextBlock
            x:Uid="EstimatedRemainingLabel"
            Style="{StaticResource SecondaryText}" />
          <TextBlock
            Text="{Binding EstimatedRemainingText}"
            Style="{StaticResource SecondaryText}" />
        </StackPanel>
      </StackPanel>
      <StackPanel
        Orientation="Horizontal"
        Spacing="10"
        HorizontalAlignment="Right">
        <TextBlock
          x:Name="StatusLabel"
          Text="{Binding StatusText}"
          Style="{StaticResource SecondaryText}"
          AutomationProperties.LiveSetting="Polite" />
        <TextBlock
          Text="{Binding Time}"
          Style="{StaticResource SecondaryText}" />
      </StackPanel>
      <StackPanel
        x:Name="DecisionPanel"
        Orientation="Horizontal"
        Spacing="8"
        HorizontalAlignment="Right">
        <Button
          x:Name="AcceptButton"
          x:Uid="AcceptButton"
          Click="AcceptClick"
          Style="{StaticResource AccentButtonStyle}" />
        <Button
          x:Name="RejectButton"
          x:Uid="RejectButton"
          Click="RejectClick" />
        <Button
          x:Name="CancelButton"
          x:Uid="CancelButton"
          Click="CancelClick" />
        <Button
          x:Name="RetryButton"
          x:Uid="RetryButton"
          Click="RetryClick" />
      </StackPanel>
      <StackPanel
        x:Name="CompletedActionsPanel"
        Orientation="Horizontal"
        HorizontalAlignment="Right">
        <Button
          x:Name="OpenLocationButton"
          x:Uid="OpenLocationButton"
          Click="OpenLocationClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
