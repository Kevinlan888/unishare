<UserControl
  x:Class="UniShare.App.Controls.IncomingOfferCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border
    x:Name="Card"
    CornerRadius="14"
    Padding="16"
    BorderThickness="1"
    BorderBrush="{ThemeResource DividerBrush}"
    Background="{ThemeResource IncomingBackground}">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState
          x:Name="Incoming">
          <VisualState.Setters>
            <Setter
              Target="Card.Background"
              Value="{ThemeResource IncomingBackground}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState
          x:Name="Outgoing">
          <VisualState.Setters>
            <Setter
              Target="Card.Background"
              Value="{ThemeResource OutgoingBackground}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <StackPanel
      Spacing="8">
      <Grid
        ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition
            Width="40" />
          <ColumnDefinition
            Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon
          Glyph="&#xE8A5;"
          FontSize="34"
          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <StackPanel
          Grid.Column="1"
          Spacing="8">
          <TextBlock
            Text="{Binding Name}"
            FontWeight="SemiBold"
            TextWrapping="Wrap" />
          <TextBlock
            Text="{Binding Size}"
            Style="{StaticResource SecondaryText}" />
        </StackPanel>
      </Grid>
      <StackPanel
        Orientation="Horizontal"
        Spacing="10"
        HorizontalAlignment="Right">
        <TextBlock
          x:Name="StatusLabel"
          Text="{Binding StatusText}"
          Style="{StaticResource SecondaryText}"
          AutomationProperties.LiveSetting="Polite" />
        <TextBlock
          Text="{Binding Time}"
          Style="{StaticResource SecondaryText}" />
      </StackPanel>
      <StackPanel
        x:Name="DecisionPanel"
        Orientation="Horizontal"
        Spacing="8"
        HorizontalAlignment="Right">
        <Button
          x:Name="AcceptButton"
          x:Uid="AcceptButton"
          Click="AcceptClick"
          Style="{StaticResource AccentButtonStyle}" />
        <Button
          x:Name="RejectButton"
          x:Uid="RejectButton"
          Click="RejectClick" />
        <Button
          x:Name="CancelButton"
          x:Uid="CancelButton"
          Click="CancelClick" />
        <Button
          x:Name="RetryButton"
          x:Uid="RetryButton"
          Click="RetryClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
