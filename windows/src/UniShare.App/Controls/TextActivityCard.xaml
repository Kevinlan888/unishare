<UserControl x:Class="UniShare.App.Controls.TextActivityCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Border x:Name="Card" CornerRadius="14" Padding="16,12" BorderThickness="1" BorderBrush="{ThemeResource DividerBrush}" Background="{ThemeResource IncomingBackground}"><VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="Incoming"><VisualState.Setters><Setter Target="Card.Background" Value="{ThemeResource IncomingBackground}"/></VisualState.Setters></VisualState><VisualState x:Name="Outgoing"><VisualState.Setters><Setter Target="Card.Background" Value="{ThemeResource OutgoingBackground}"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><StackPanel Spacing="8"><TextBlock x:Name="OriginLabel" x:Uid="ClipboardOrigin" FontWeight="SemiBold" Visibility="Collapsed"/><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16" IsTextSelectionEnabled="True"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"><TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" FontSize="11" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding Time}" Style="{StaticResource SecondaryText}" FontSize="11"/></StackPanel></Grid><StackPanel x:Name="DecisionPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button x:Name="AcceptButton" x:Uid="AcceptButton" Click="AcceptClick" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="RejectButton" x:Uid="RejectButton" Click="RejectClick"/><Button x:Name="CancelButton" x:Uid="CancelButton" Click="CancelClick"/><Button x:Name="RetryButton" x:Uid="RetryButton" Click="RetryClick"/></StackPanel></StackPanel></Border></UserControl>
