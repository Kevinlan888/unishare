<Window
  x:Class="UniShare.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid
    x:Name="Root"
    Background="{ThemeResource ShellBackground}">
    <Grid.RowDefinitions>
      <RowDefinition
        Height="50" />
      <RowDefinition
        Height="*" />
    </Grid.RowDefinitions>
    <Grid
      x:Name="TitleBar"
      Padding="24,0,140,0">
      <StackPanel
        Orientation="Horizontal"
        Spacing="12"
        VerticalAlignment="Center">
        <Image
          Source="ms-appx:///Assets/Square44x44Logo.png"
          Width="22"
          Height="22"
          Stretch="Uniform" />
        <TextBlock
          x:Name="WindowTitleText"
          x:Uid="WindowTitle"
          FontSize="20"
          FontWeight="SemiBold" />
      </StackPanel>
    </Grid>
    <ContentControl
      x:Name="ShellHost"
      Grid.Row="1"
      HorizontalContentAlignment="Stretch"
      VerticalContentAlignment="Stretch" />
  </Grid>
</Window>
