<UserControl x:Class="UniShare.App.Features.Share.DeviceListPane"  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:UniShare.App">
<ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Padding="12,24,12,16" Spacing="12">
<StackPanel x:Name="Navigation" Spacing="6">
<Button Style="{StaticResource NavigationButton}" x:Uid="NavShare" Tag="Share" Click="NavigateClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="{ThemeResource SelectedBackground}"><StackPanel Orientation="Horizontal" Spacing="16"><FontIcon Glyph="&#xE72D;"/><TextBlock x:Name="ShareLabel" x:Uid="ShareLabel"/></StackPanel></Button>
<Button Style="{StaticResource NavigationButton}" x:Uid="NavDevices" Tag="Devices" Click="NavigateClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="16"><FontIcon Glyph="&#xE7F4;"/><TextBlock x:Name="DevicesLabel" x:Uid="DevicesLabel"/></StackPanel></Button>
<Button Style="{StaticResource NavigationButton}" x:Uid="NavHistory" Tag="History" Click="NavigateClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="16"><FontIcon Glyph="&#xE81C;"/><TextBlock x:Name="HistoryLabel" x:Uid="HistoryLabel"/></StackPanel></Button>
<Button Style="{StaticResource NavigationButton}" x:Uid="NavSettings" Tag="Settings" Click="NavigateClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="16"><FontIcon Glyph="&#xE713;"/><TextBlock x:Name="SettingsLabel" x:Uid="SettingsLabel"/></StackPanel></Button>
</StackPanel>
<TextBlock x:Name="RecentHeading" x:Uid="RecentHeading" Style="{StaticResource PaneHeading}" Margin="12,24,0,0"/>
<ListView x:Name="RecentList" IsItemClickEnabled="True" ItemClick="SelectDevice" SelectionMode="Single" ItemsSource="{Binding Recent}" ScrollViewer.VerticalScrollBarVisibility="Disabled">
<ListView.ItemTemplate><DataTemplate><Grid Padding="6,10" ColumnSpacing="12" AutomationProperties.Name="{Binding AccessibleName}"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="{Binding Glyph}" FontSize="28"/><StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="9" Height="9" Opacity="{Binding OnlineIndicatorOpacity}" Fill="{ThemeResource OnlineBrush}"/><TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel><TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="12" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="4,0,0,1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></DataTemplate></ListView.ItemTemplate>
</ListView>
<TextBlock x:Name="NearbyHeading" x:Uid="NearbyHeading" Style="{StaticResource PaneHeading}" Margin="12,24,0,0"/>
<ListView x:Name="NearbyList" IsItemClickEnabled="True" ItemClick="SelectDevice" SelectionMode="Single" ItemsSource="{Binding Nearby}" ScrollViewer.VerticalScrollBarVisibility="Disabled">
<ListView.ItemTemplate><DataTemplate><Grid Padding="6,12" ColumnSpacing="12" AutomationProperties.Name="{Binding AccessibleName}"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="{Binding Glyph}" FontSize="28"/><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="9" Height="9" Opacity="{Binding OnlineIndicatorOpacity}" Fill="{ThemeResource OnlineBrush}"/><TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}"/></StackPanel></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
</ListView><TextBlock x:Name="EmptyHint" x:Uid="EmptyHint" TextWrapping="Wrap" Visibility="Collapsed"/>
</StackPanel></ScrollViewer></UserControl>
