<UserControl
  x:Class="UniShare.App.Features.Share.DeviceListPane"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:UniShare.App">
  <UserControl.Resources>
    <Style
      x:Key="CompactDeviceItemContainerStyle"
      TargetType="ListViewItem">
      <Setter
        Property="HorizontalAlignment"
        Value="Stretch" />
      <Setter
        Property="HorizontalContentAlignment"
        Value="Center" />
      <Setter
        Property="Padding"
        Value="0" />
      <Setter
        Property="MinHeight"
        Value="44" />
    </Style>
    <DataTemplate x:Key="RecentDeviceTemplate">
      <Grid
        Padding="6,10"
        ColumnSpacing="12"
        AutomationProperties.Name="{Binding AccessibleName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="32" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon
          Glyph="{Binding Glyph}"
          FontSize="28" />
        <StackPanel
          Grid.Column="1"
          Spacing="7">
          <TextBlock
            Text="{Binding Name}"
            FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis" />
          <StackPanel
            Orientation="Horizontal"
            Spacing="8">
            <Ellipse
              Width="9"
              Height="9"
              Opacity="{Binding OnlineIndicatorOpacity}"
              Fill="{ThemeResource OnlineBrush}" />
            <TextBlock
              Text="{Binding Summary}"
              Style="{StaticResource SecondaryText}"
              TextWrapping="NoWrap"
              TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <TextBlock
          Grid.Column="2"
          Text="{Binding Time}"
          FontSize="12"
          VerticalAlignment="Bottom"
          HorizontalAlignment="Right"
          Margin="4,0,0,1"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="NearbyDeviceTemplate">
      <Grid
        Padding="0,12"
        ColumnSpacing="12"
        AutomationProperties.Name="{Binding AccessibleName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="32" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon
          Glyph="{Binding Glyph}"
          FontSize="28" />
        <StackPanel
          Grid.Column="1"
          Spacing="8">
          <TextBlock
            Text="{Binding Name}"
            FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis" />
          <StackPanel
            Orientation="Horizontal"
            Spacing="8">
            <Ellipse
              Width="9"
              Height="9"
              Opacity="{Binding OnlineIndicatorOpacity}"
              Fill="{ThemeResource OnlineBrush}" />
            <TextBlock
              Text="{Binding StatusText}"
              Style="{StaticResource SecondaryText}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="CompactDeviceTemplate">
      <Grid
        Width="44"
        Height="44"
        Margin="-16,0,16,0"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        AutomationProperties.Name="{Binding AccessibleName}"
        ToolTipService.ToolTip="{Binding Name}">
        <FontIcon
          Glyph="{Binding Glyph}"
          FontSize="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center" />
        <Ellipse
          Width="7"
          Height="7"
          Margin="0,0,5,5"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Opacity="{Binding OnlineIndicatorOpacity}"
          Fill="{ThemeResource OnlineBrush}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer
    HorizontalScrollBarVisibility="Disabled">
    <StackPanel
      Padding="12,24,12,16"
      Spacing="12">
      <StackPanel
        x:Name="Navigation"
        Spacing="6">
        <Button
          Style="{StaticResource SelectedNavigationButton}"
          x:Uid="NavShare"
          Tag="Share"
          Click="NavigateClick"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Left">
          <StackPanel
            Orientation="Horizontal"
            Spacing="16">
            <FontIcon
              Glyph="&#xE72D;" />
            <TextBlock
              x:Name="ShareLabel"
              x:Uid="ShareLabel" />
          </StackPanel>
        </Button>
        <Button
          Style="{StaticResource NavigationButton}"
          x:Uid="NavDevices"
          Tag="Devices"
          Click="NavigateClick"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Left">
          <StackPanel
            Orientation="Horizontal"
            Spacing="16">
            <FontIcon
              Glyph="&#xE7F4;" />
            <TextBlock
              x:Name="DevicesLabel"
              x:Uid="DevicesLabel" />
          </StackPanel>
        </Button>
        <Button
          Style="{StaticResource NavigationButton}"
          x:Uid="NavHistory"
          Tag="History"
          Click="NavigateClick"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Left">
          <StackPanel
            Orientation="Horizontal"
            Spacing="16">
            <FontIcon
              Glyph="&#xE81C;" />
            <TextBlock
              x:Name="HistoryLabel"
              x:Uid="HistoryLabel" />
          </StackPanel>
        </Button>
        <Button
          Style="{StaticResource NavigationButton}"
          x:Uid="NavSettings"
          Tag="Settings"
          Click="NavigateClick"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Left">
          <StackPanel
            Orientation="Horizontal"
            Spacing="16">
            <FontIcon
              Glyph="&#xE713;" />
            <TextBlock
              x:Name="SettingsLabel"
              x:Uid="SettingsLabel" />
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBlock
        x:Name="RecentHeading"
        x:Uid="RecentHeading"
        Style="{StaticResource PaneHeading}"
        Margin="12,24,0,0" />
      <ListView
        x:Name="RecentList"
        IsItemClickEnabled="True"
        ItemClick="SelectDevice"
        SelectionMode="Single"
        ItemsSource="{Binding Recent}"
        ItemTemplate="{StaticResource RecentDeviceTemplate}"
        ScrollViewer.VerticalScrollBarVisibility="Disabled" />
      <TextBlock
        x:Name="NearbyHeading"
        x:Uid="NearbyHeading"
        Style="{StaticResource PaneHeading}"
        Margin="12,24,0,0" />
      <ListView
        x:Name="NearbyList"
        IsItemClickEnabled="True"
        ItemClick="SelectDevice"
        SelectionMode="Single"
        ItemsSource="{Binding Nearby}"
        ItemTemplate="{StaticResource NearbyDeviceTemplate}"
        ScrollViewer.VerticalScrollBarVisibility="Disabled" />
      <TextBlock
        x:Name="EmptyHint"
        x:Uid="EmptyHint"
        TextWrapping="Wrap"
        Visibility="Collapsed" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
