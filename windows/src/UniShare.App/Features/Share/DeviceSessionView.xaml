<UserControl
  x:Class="UniShare.App.Features.Share.DeviceSessionView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:UniShare.App">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition
        Height="82" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="*" />
      <RowDefinition
        Height="Auto" />
    </Grid.RowDefinitions>
    <Border
      BorderBrush="{ThemeResource DividerBrush}"
      BorderThickness="0,1,0,1"
      Padding="28,12">
      <Grid
        ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition
            Width="32" />
          <ColumnDefinition
            Width="*" />
          <ColumnDefinition
            Width="Auto" />
          <ColumnDefinition
            Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon
          Glyph="{Binding SelectedDevice.Glyph}"
          FontSize="32" />
        <StackPanel
          Grid.Column="1"
          VerticalAlignment="Center"
          Spacing="6">
          <TextBlock
            Text="{Binding SelectedDevice.Name}"
            FontSize="20"
            FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis" />
          <TextBlock
            x:Name="OnlineStatus"
            Style="{StaticResource SecondaryText}" />
        </StackPanel>
        <Button
          Grid.Column="2"
          x:Uid="SearchAction"
          Style="{StaticResource IconButton}"
          Click="SearchClick">
          <FontIcon
            Glyph="&#xE721;" />
        </Button>
        <Button
          Grid.Column="3"
          x:Uid="DetailsAction"
          Style="{StaticResource IconButton}">
          <FontIcon
            Glyph="&#xE712;" />
          <Button.Flyout>
            <Flyout>
              <ScrollViewer
                MaxHeight="520">
                <ContentControl
                  x:Name="DetailsFlyout" />
              </ScrollViewer>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>
    <StackPanel
      Grid.Row="1"
      Spacing="8"
      Margin="24,8">
      <InfoBar
        x:Name="NoticeBar"
        IsOpen="False"
        IsClosable="True"
        Severity="Informational" />
      <TextBox
        x:Name="SearchBox"
        x:Uid="SearchBox"
        Visibility="Collapsed"
        TextChanged="SearchChanged" />
    </StackPanel>
    <ScrollViewer
      x:Name="ActivityScroll"
      Grid.Row="2"
      HorizontalScrollBarVisibility="Disabled"
      Padding="28,4,28,12">
      <StackPanel
        Spacing="10">
        <TextBlock
          x:Uid="TodayLabel"
          HorizontalAlignment="Center"
          Style="{StaticResource SecondaryText}"
          Margin="0,0,0,8" />
        <TextBlock
          x:Name="StateHint"
          HorizontalAlignment="Center"
          TextWrapping="Wrap" />
        <StackPanel
          x:Name="ActivityHost"
          Spacing="10" />
      </StackPanel>
    </ScrollViewer>
    <Grid
      Grid.Row="3"
      Padding="20,12,20,20"
      ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition
          Width="Auto" />
        <ColumnDefinition
          Width="*" />
        <ColumnDefinition
          Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
        x:Uid="AddAction"
        Style="{StaticResource IconButton}"
        IsEnabled="{Binding CanSend}">
        <FontIcon
          Glyph="&#xE710;" />
        <Button.Flyout>
          <MenuFlyout>
            <MenuFlyoutItem
              x:Uid="PhotoMenu"
              Command="{Binding SendPhotoCommand}">
              <MenuFlyoutItem.Icon>
                <FontIcon
                  Glyph="&#xEB9F;" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
              x:Uid="FileMenu"
              Command="{Binding SendFileCommand}">
              <MenuFlyoutItem.Icon>
                <FontIcon
                  Glyph="&#xE8A5;" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
              x:Uid="ClipboardMenu"
              Command="{Binding SendClipboardCommand}">
              <MenuFlyoutItem.Icon>
                <FontIcon
                  Glyph="&#xE77F;" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <TextBox
        x:Name="Composer"
        AllowDrop="True"
        DragOver="ComposerDragOver"
        Drop="ComposerDrop"
        Grid.Column="1"
        x:Uid="Composer"
        Text="{Binding ComposerText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        IsEnabled="{Binding CanSend}"
        AcceptsReturn="True"
        TextWrapping="Wrap"
        MinHeight="48"
        MaxHeight="120"
        CornerRadius="24"
        Padding="18,12">
        <TextBox.KeyboardAccelerators>
          <KeyboardAccelerator
            Key="Enter"
            Modifiers="Control"
            Invoked="SendAccelerator" />
        </TextBox.KeyboardAccelerators>
      </TextBox>
      <Button
        Grid.Column="2"
        x:Uid="SendAction"
        Command="{Binding SendTextCommand}"
        Style="{StaticResource AccentButtonStyle}"
        Width="50"
        Height="50"
        CornerRadius="25">
        <FontIcon
          Glyph="&#xE724;" />
      </Button>
    </Grid>
  </Grid>
</UserControl>
