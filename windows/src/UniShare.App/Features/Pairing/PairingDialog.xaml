<ContentDialog x:Class="UniShare.App.Features.Pairing.PairingDialog" x:Uid="PairingDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 PrimaryButtonCommand="{Binding ConfirmMatchesCommand}" SecondaryButtonCommand="{Binding RejectCommand}"
 DefaultButton="None" PrimaryButtonClick="MatchClick" SecondaryButtonClick="MismatchClick">
 <StackPanel Spacing="20">
  <TextBlock x:Uid="PairingInstruction" TextWrapping="Wrap"/>
  <TextBlock x:Uid="PairingCode" Text="{Binding PendingRequest.VerificationCode}" FontSize="32" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
  <TextBlock x:Name="FailureText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel>
</ContentDialog>
