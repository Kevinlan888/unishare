<UserControl
  x:Class="UniShare.App.Features.Devices.DevicesPage"
  x:Uid="DevicesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel
      Padding="28"
      Spacing="20">
      <TextBlock
        x:Uid="DevicesHeading"
        FontSize="28"
        FontWeight="SemiBold" />
      <TextBlock
        x:Uid="DevicesDescription"
        TextWrapping="Wrap" />
      <ItemsControl
        ItemsSource="{Binding Recent}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border
              Style="{StaticResource CardStyle}"
              Margin="0,0,0,10">
              <StackPanel
                Orientation="Horizontal"
                Spacing="16">
                <FontIcon
                  Glyph="{Binding Glyph}" />
                <TextBlock
                  Text="{Binding Name}"
                  FontWeight="SemiBold" />
                <TextBlock
                  Text="{Binding Platform}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock
        x:Uid="NearbyHeading"
        Style="{StaticResource PaneHeading}" />
      <ItemsControl
        ItemsSource="{Binding Nearby}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border
              Style="{StaticResource CardStyle}"
              Margin="0,0,0,10">
              <StackPanel
                Orientation="Horizontal"
                Spacing="16">
                <FontIcon
                  Glyph="{Binding Glyph}" />
                <TextBlock
                  Text="{Binding Name}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
