<UserControl
  x:Class="UniShare.App.Features.Settings.SettingsPage"
  x:Uid="SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel
      Padding="28"
      Spacing="20">
      <TextBlock
        x:Uid="SettingsHeading"
        FontSize="28"
        FontWeight="SemiBold" />
      <InfoBar
        x:Name="DemoSettingsInfo"
        x:Uid="DemoSettingsInfo"
        IsOpen="False"
        IsClosable="False" />
      <InfoBar
        x:Name="SettingsSaveError"
        Severity="Error"
        IsOpen="False"
        IsClosable="True" />
      <TextBox
        x:Name="DeviceNameSetting"
        x:Uid="DeviceNameSetting"
        TextChanged="DeviceNameChanged" />
      <TextBox
        x:Name="ReceiveFolderSetting"
        x:Uid="ReceiveFolderSetting"
        IsReadOnly="True" />
      <ToggleSwitch
        x:Name="NotificationSetting"
        x:Uid="NotificationSetting"
        Toggled="NotificationChanged" />
      <ToggleSwitch
        x:Name="StartupChoice"
        x:Uid="StartupSetting"
        IsEnabled="False"
        Toggled="StartupChanged" />
      <ComboBox
        x:Name="ThemeChoice"
        x:Uid="ThemeChoice"
        SelectionChanged="ThemeChanged">
        <ComboBoxItem
          x:Uid="SystemTheme" />
        <ComboBoxItem
          x:Uid="LightTheme" />
        <ComboBoxItem
          x:Uid="DarkTheme" />
      </ComboBox>
      <ComboBox
        x:Name="LanguageChoice"
        x:Uid="LanguageChoice"
        SelectionChanged="LanguageChanged">
        <ComboBoxItem
          x:Uid="SystemLanguage" />
        <ComboBoxItem
          Content="English" />
        <ComboBoxItem
          Content="简体中文" />
      </ComboBox>
      <TextBlock
        x:Name="LanguageHint"
        TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
