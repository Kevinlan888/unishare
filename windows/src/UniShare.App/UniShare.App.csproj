<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
    <EnableDefaultAssets>false</EnableDefaultAssets>
    <NativeStageRoot>$(MSBuildThisFileDirectory)..\..\artifacts\native</NativeStageRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <ProjectReference Include="../UniShare.Application/UniShare.Application.csproj" />
    <ProjectReference Include="../UniShare.Native/UniShare.Native.csproj" />
    <ProjectReference Include="../UniShare.Infrastructure/UniShare.Infrastructure.csproj" />
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="licenses\NLog-LICENSE.txt" Link="licenses\NLog-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="Assets\**" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(NativeStageRoot)\bin\unishare.dll')">
    <Content Include="$(NativeStageRoot)\bin\unishare.dll;$(NativeStageRoot)\bin\libcrypto-3*.dll;$(NativeStageRoot)\bin\libssl-3*.dll"
             Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NativeStageRoot)\licenses\*.txt" Link="licenses\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireNativeStageForPackage" BeforeTargets="PrepareForBuild" Condition="'$(GenerateAppxPackageOnBuild)' == 'true'">
    <Error Condition="!Exists('$(NativeStageRoot)\bin\unishare.dll')" Text="Missing staged unishare.dll; run windows/scripts/build-native.ps1 first." />
    <Error Condition="!Exists('$(NativeStageRoot)\licenses\OpenSSL-NOTICES.txt')" Text="Missing OpenSSL redistribution notices." />
  </Target>
</Project>
